<view class="page">
  <view wx:if="{{loading}}" class="subtle">加载中…</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <view wx:elif="{{!items.length}}" class="subtle line">暂无收货地址</view>
  <view wx:else>
    <view wx:for="{{items}}" wx:key="id" class="card gap address-card">
      <view class="address-head">
        <view class="h2">{{item.receiver_name}}</view>
        <view class="subtle">{{item.receiver_mobile}}</view>
        <view wx:if="{{item.is_default}}" class="tag-default">默认</view>
      </view>
      <view class="subtle section">{{item.province}}{{item.city}}{{item.district}} {{item.detail_address}}</view>
      <view class="row">
        <view class="btn secondary" data-id="{{item.id}}" bindtap="edit">编辑</view>
        <view class="btn ghost" data-id="{{item.id}}" bindtap="remove">删除</view>
      </view>
    </view>
  </view>
  <view class="btn" bindtap="add">新增地址</view>
</view>
