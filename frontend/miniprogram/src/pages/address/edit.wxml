<view class="page">
  <view class="card gap">
    <view class="h2 section">{{addressId ? '编辑地址' : '新增地址'}}</view>
    <view class="form-row">
      <view class="subtle">收货人</view>
      <input class="input" value="{{form.receiver_name}}" data-field="receiver_name" bindinput="onInput" placeholder="姓名" />
    </view>
    <view class="form-row">
      <view class="subtle">手机号</view>
      <input class="input" type="number" maxlength="11" value="{{form.receiver_mobile}}" data-field="receiver_mobile" bindinput="onInput" placeholder="11 位手机号" />
    </view>
    <view class="form-row">
      <view class="subtle">省</view>
      <input class="input" value="{{form.province}}" data-field="province" bindinput="onInput" placeholder="省" />
    </view>
    <view class="form-row">
      <view class="subtle">市</view>
      <input class="input" value="{{form.city}}" data-field="city" bindinput="onInput" placeholder="市" />
    </view>
    <view class="form-row">
      <view class="subtle">区</view>
      <input class="input" value="{{form.district}}" data-field="district" bindinput="onInput" placeholder="区/县" />
    </view>
    <view class="form-row">
      <view class="subtle">详细地址</view>
      <input class="input" value="{{form.detail_address}}" data-field="detail_address" bindinput="onInput" placeholder="街道门牌等" />
    </view>
    <view class="form-row">
      <view class="subtle">邮编（选填）</view>
      <input class="input" type="number" maxlength="6" value="{{form.postal_code}}" data-field="postal_code" bindinput="onInput" />
    </view>
    <checkbox-group bindchange="onDefaultChange">
      <label>
        <checkbox value="default" checked="{{form.is_default}}" /> 设为默认地址
      </label>
    </checkbox-group>
  </view>
  <view class="btn" bindtap="save">{{loading ? '保存中…' : '保存'}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
