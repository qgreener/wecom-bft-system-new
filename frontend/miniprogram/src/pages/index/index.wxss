page {
  min-height: 100%;
  background: #f6f8fb;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 140rpx;
}

.page.with-bottom-bar {
  padding-bottom: 188rpx;
}

.section {
  margin-bottom: 20rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.25;
}

.h2 {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1.35;
}

.subtle {
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.muted {
  color: #94a3b8;
}

.price {
  color: #b45309;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 76rpx;
  padding: 0 22rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 10rpx;
  background: #ffffff;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dbe3ee;
  border-radius: 10rpx;
  background: #ffffff;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 76rpx;
  padding: 0 28rpx;
  border-radius: 10rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
}

.btn.secondary {
  background: #eef6f5;
  color: #0f766e;
}

.btn.ghost {
  background: #ffffff;
  color: #334155;
  border: 1rpx solid #dbe3ee;
}

.btn.danger {
  background: #fef2f2;
  color: #b91c1c;
}

.btn.disabled {
  background: #e5e7eb;
  color: #94a3b8;
}

.chip-row {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin: 18rpx 0;
}

.chip {
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #dbe3ee;
  color: #475569;
  display: flex;
  align-items: center;
  background: #ffffff;
}

.chip.active {
  border-color: #0f766e;
  background: #e7f6f4;
  color: #0f766e;
  font-weight: 700;
}

.status-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  background: #eef2f7;
  color: #475569;
}

.status-tag.success {
  background: #dcfce7;
  color: #166534;
}

.status-tag.warning {
  background: #fef3c7;
  color: #92400e;
}

.status-tag.danger {
  background: #fee2e2;
  color: #991b1b;
}

.status-tag.info {
  background: #dbeafe;
  color: #1e40af;
}

.course-cover {
  width: 164rpx;
  height: 124rpx;
  border-radius: 10rpx;
  background: #dbeafe;
  flex: none;
}

.course-body {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.line {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.line:last-child {
  border-bottom: 0;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 24rpx 34rpx;
  background: #ffffff;
  border-top: 1rpx solid #e5e7eb;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-sizing: border-box;
}

.bottom-bar .btn {
  min-width: 220rpx;
}

.empty,
.error,
.loading {
  padding: 72rpx 32rpx;
  text-align: center;
  color: #64748b;
}

.error {
  color: #b91c1c;
}

.gap {
  border: 1rpx dashed #f59e0b;
  background: #fffbeb;
  color: #92400e;
}

.step {
  position: relative;
  padding: 0 0 28rpx 34rpx;
  border-left: 2rpx solid #cbd5e1;
}

.step.active {
  border-left-color: #0f766e;
}
