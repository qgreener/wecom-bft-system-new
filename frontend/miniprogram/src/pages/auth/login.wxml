<view class="page">
  <view class="card">
    <view class="title">微信登录 Mock</view>
    <view class="subtle section">当前后端只接收 mock 登录码与 mock 手机号授权；登录态会持久化到本地存储。</view>
    <view wx:if="{{session}}" class="line">
      <view class="h2">{{session.studentNo}}</view>
      <view class="subtle">手机号：{{mobileText}}</view>
    </view>
    <view wx:else class="subtle line">尚未登录</view>
    <view class="btn" bindtap="login">微信登录 Mock</view>
  </view>

  <view class="card">
    <view class="h2 section">手机号授权 Mock</view>
    <input class="input section" value="{{phone}}" type="number" maxlength="11" bindinput="onPhoneInput" placeholder="Mock 手机号" />
    <view class="btn secondary" bindtap="authorizePhone">授权当前手机号</view>
  </view>

  <view wx:if="{{loading}}" class="loading">处理中</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
