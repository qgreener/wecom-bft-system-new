<view class="page">
  <view class="section row">
    <input class="input" value="{{keyword}}" bindinput="onKeywordInput" placeholder="搜索课程名称" />
    <view class="btn secondary" style="margin-left: 14rpx;" bindtap="search">搜索</view>
  </view>

  <view class="chip-row">
    <view class="chip {{courseType === '' ? 'active' : ''}}" data-type="" bindtap="setType">全部</view>
    <view class="chip {{courseType === 'LIVE' ? 'active' : ''}}" data-type="LIVE" bindtap="setType">直播课</view>
    <view class="chip {{courseType === 'RECORDED' ? 'active' : ''}}" data-type="RECORDED" bindtap="setType">录制课</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载课程中</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <view wx:elif="{{records.length === 0}}" class="empty">暂无可售课程</view>
  <view wx:else>
    <view wx:for="{{records}}" wx:key="course_id" class="card row" data-id="{{item.course_id}}" bindtap="openDetail">
      <image wx:if="{{item.cover_url}}" class="course-cover" src="{{item.cover_url}}" mode="aspectFill" />
      <view wx:else class="course-cover"></view>
      <view class="course-body">
        <view class="h2">{{item.course_title}}</view>
        <view class="subtle">{{item.summary || '暂无简介'}}</view>
        <view class="between" style="margin-top: 14rpx;">
          <text class="price">{{item.price_text}} 起</text>
          <view class="status-row">
            <text class="status-tag info">{{item.type_text}}</text>
            <text class="status-tag {{item.status_tone}}">{{item.status_text}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
