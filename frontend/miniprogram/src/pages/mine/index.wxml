<view class="page">
  <view class="card">
    <view class="between">
      <view>
        <view class="title">{{session ? session.studentNo : '未登录'}}</view>
        <view class="subtle">手机号：{{mobileText}}</view>
      </view>
      <view wx:if="{{!session}}" class="btn" bindtap="login">登录</view>
      <view wx:else class="btn ghost" bindtap="logout">退出</view>
    </view>
  </view>

  <view class="card">
    <view class="line between" bindtap="notifications"><text>通知信息</text><text class="muted">查看</text></view>
    <view class="line between" bindtap="orders"><text>我的订单</text><text class="muted">查看</text></view>
    <view class="line between" bindtap="invoices"><text>发票信息</text><text class="muted">维护</text></view>
    <view class="line between" bindtap="addresses"><text>收货地址</text><text class="muted">接口缺口</text></view>
  </view>

  <view wx:if="{{loading}}" class="loading">刷新登录态</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
