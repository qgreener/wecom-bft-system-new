APP_ENV=dev
APP_NAME=wecom-bft-new-system
APP_VERSION=0.1.0-SNAPSHOT
APP_PUBLIC_BASE_URL=http://localhost:5173
APP_CALLBACK_PUBLIC_BASE_URL=http://localhost:8080
APP_MAINTENANCE_MODE=false

SERVER_PORT=8080

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=wecom_bft_new
MYSQL_USERNAME=wecom_bft_app
MYSQL_PASSWORD=MYSQL_PASSWORD_PLACEHOLDER

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REDIS_PASSWORD_PLACEHOLDER

FILE_STORAGE_TYPE=local
FILE_UPLOAD_BASE_PATH=./storage/files
FILE_MAX_UPLOAD_SIZE_MB=20
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=wecom-bft-demo
STORAGE_ACCESS_KEY=STORAGE_ACCESS_KEY_PLACEHOLDER
STORAGE_SECRET_KEY=STORAGE_SECRET_KEY_PLACEHOLDER

SECURITY_JWT_SECRET=JWT_SECRET_PLACEHOLDER
SECURITY_SESSION_SECRET=SESSION_SECRET_PLACEHOLDER
SECURITY_TOKEN_TTL_SECONDS=7200

INTEGRATION_DEFAULT_MODE=mock
INTEGRATION_PAYMENT_MODE=mock
INTEGRATION_REFUND_MODE=mock
INTEGRATION_LOGISTICS_MODE=mock
INTEGRATION_INVOICE_MODE=mock
INTEGRATION_WECOM_MODE=mock
INTEGRATION_MESSAGE_MODE=mock

WECHAT_MP_APP_ID=WECHAT_MP_APP_ID_PLACEHOLDER
WECHAT_MP_SECRET=WECHAT_MP_SECRET_PLACEHOLDER

WECOM_CORP_ID=WECOM_CORP_ID_PLACEHOLDER
WECOM_AGENT_ID=WECOM_AGENT_ID_PLACEHOLDER
WECOM_SECRET=WECOM_SECRET_PLACEHOLDER
WECOM_CALLBACK_TOKEN=WECOM_CALLBACK_TOKEN_PLACEHOLDER
WECOM_CALLBACK_AES_KEY=WECOM_CALLBACK_AES_KEY_PLACEHOLDER

WECHAT_PAY_MCH_ID=WECHAT_PAY_MCH_ID_PLACEHOLDER
WECHAT_PAY_API_V3_KEY=WECHAT_PAY_API_V3_KEY_PLACEHOLDER
WECHAT_PAY_PRIVATE_KEY_PATH=/etc/wecom-bft-new-system/certs/pay/private-key.pem
WECHAT_PAY_PLATFORM_CERT_PATH=/etc/wecom-bft-new-system/certs/pay/platform-cert.pem
WECHAT_PAY_CALLBACK_URL=http://localhost:8080/api/callbacks/payments/wechat
WECHAT_PAY_REFUND_CALLBACK_URL=http://localhost:8080/api/callbacks/refunds/wechat

LOGISTICS_PROVIDER=mock-logistics
LOGISTICS_API_KEY=LOGISTICS_API_KEY_PLACEHOLDER
LOGISTICS_CALLBACK_URL=http://localhost:8080/api/callbacks/logistics/traces

INVOICE_PROVIDER=mock-invoice
INVOICE_API_KEY=INVOICE_API_KEY_PLACEHOLDER
INVOICE_ISSUE_CALLBACK_URL=http://localhost:8080/api/callbacks/invoices/issue
INVOICE_RED_CALLBACK_URL=http://localhost:8080/api/callbacks/invoices/red-reverse

MAIL_HOST=smtp.example.invalid
MAIL_PORT=465
MAIL_USERNAME=MAIL_USERNAME_PLACEHOLDER
MAIL_PASSWORD=MAIL_PASSWORD_PLACEHOLDER
MAIL_FROM=no-reply@example.invalid

FLYWAY_ENABLED=true
MANAGEMENT_HEALTH_ENABLED=true
BACKUP_RETENTION_DAYS=14
EXPORT_FILE_RETENTION_DAYS=7
