# =============================================================================
# Phase E 部署环境变量模板
# 复制为同目录的 .env （不进 git，由 docker-compose 自动加载）后填入真实凭据
# =============================================================================

# ---- 域名与公网 ----
APP_PUBLIC_BASE_URL=https://finhub.tax
APP_CALLBACK_PUBLIC_BASE_URL=https://finhub.tax

# ---- 数据库 ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=wecom_bft_new
MYSQL_USERNAME=wecom_bft_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 集成模式（mock | real）----
INTEGRATION_DEFAULT_MODE=mock
INTEGRATION_PAYMENT_MODE=mock
INTEGRATION_REFUND_MODE=mock
INTEGRATION_LOGISTICS_MODE=mock
INTEGRATION_INVOICE_MODE=mock
INTEGRATION_WECOM_MODE=mock
INTEGRATION_MESSAGE_MODE=mock
# Phase A 真实接入：把下面两项改为 real
INTEGRATION_WECOM_AUTH_MODE=mock
INTEGRATION_WECHAT_MINIAPP_AUTH_MODE=mock

# ---- 企业微信自建应用 ----
# 企微管理后台 → 我的企业 / 自建应用 拷过来
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_AGENT_SECRET=
# 必须与企微「网页授权及 JS-SDK」可信域名一致
WECOM_OAUTH_REDIRECT_URI=https://finhub.tax/api/admin/auth/wecom-oauth/callback

# ---- 微信小程序 ----
WECHAT_MINIAPP_APP_ID=
WECHAT_MINIAPP_APP_SECRET=
WECHAT_MINIAPP_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# ---- 文件存储 ----
FILE_STORAGE_TYPE=local
FILE_UPLOAD_BASE_PATH=/var/wecom-bft/storage/files
FILE_MAX_UPLOAD_SIZE_MB=20

# ---- 应用基础 ----
APP_NAME=wecom-bft-new-system
APP_VERSION=0.1.0
APP_ENV=prod
APP_MAINTENANCE_MODE=false
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ---- Flyway ----
FLYWAY_ENABLED=true
