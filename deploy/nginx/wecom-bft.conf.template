server {
    listen 80;
    server_name _;

    client_max_body_size 20m;

    location /api/ {
        proxy_pass http://backend:8080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Trace-Id $request_id;
    }

    location /admin/ {
        alias /usr/share/nginx/html/admin/;
        try_files $uri $uri/ /admin/index.html;
    }

    location /h5/wecom-sidebar/ {
        alias /usr/share/nginx/html/h5/wecom-sidebar/;
        try_files $uri $uri/ /h5/wecom-sidebar/index.html;
    }

    location /h5/supplier/ {
        alias /usr/share/nginx/html/h5/supplier/;
        try_files $uri $uri/ /h5/supplier/index.html;
    }

    location /h5/lead/ {
        alias /usr/share/nginx/html/h5/lead/;
        try_files $uri $uri/ /h5/lead/index.html;
    }
}
